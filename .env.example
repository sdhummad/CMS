# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used for privileged operations (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app, used to build the OAuth/OTP callback redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email) -- absence and future report-card emails.
# Without this set, emails are logged to the console instead of sent,
# so local dev works without a Resend account.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL="Gujarati Class <notifications@yourdomain.org>"
